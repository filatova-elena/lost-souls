<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{% if title %}{{ title }}{% elif refs.instructions.title %}{{ refs.instructions.title }} - {{ refs.instructions.subtitle }}{% else %}The Lost Souls of Kennebec Avenue Investigation{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="icon" href="{{ site.baseUrl }}assets/icons/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ site.baseUrl }}assets/icons/apple-touch-icon.png">
  <link rel="stylesheet" href="{{ site.baseUrl }}css/styles.css">
  {% block gameStyles %}
  <link rel="stylesheet" href="{{ site.baseUrl }}css/qr-scanner.css">
  <link rel="stylesheet" href="{{ site.baseUrl }}clues/progress.css">
  {% endblock %}
</head>
<body>
  {{ content | safe }}
  {% block tracker %}{% include "clues/progress-tracker.njk" %}{% endblock %}
  {% block scripts %}
  <script src="{{ site.baseUrl }}js/skills.js" defer></script>
  <script src="{{ site.baseUrl }}js/clue-access.js" defer></script>
  <script src="{{ site.baseUrl }}js/effects.js" defer></script>
  <script src="{{ site.baseUrl }}js/main.js" defer></script>
  <script src="{{ site.baseUrl }}js/vendor/html5-qrcode.min.js" defer></script>
  <script src="{{ site.baseUrl }}js/qr-scanner.js" defer></script>
  {% if page.url == '/reset/' %}
  <script src="{{ site.baseUrl }}js/reset.js" defer></script>
  {% else %}
  <script src="{{ site.baseUrl }}js/clue-page.js" defer></script>
  {% endif %}
  {% endblock %}
</body>
</html>
